# Host Telemetry & Notification Overrides
# Deploy to /etc/conditional-reboot.conf.d/99-local.conf (chmod 600, root:root)

# NTFY Fleet Topics (3-Channel Architecture: <16_RANDOM_HEX_CHARS>-<SYSTEM_GROUP_NAME>-<SUBTOPIC>)
# Note: NTFY topics are strictly flat (max 64 characters: alphanumeric, hyphens, underscores).
# NTFY_ALERTS_TOPIC:  Urgent alarms, systemd failures, update errors, and Healthchecks watchdog target (observer stream)
# NTFY_REBOOT_TOPIC:  Reboot notifications (scheduled, deferred, and boot success confirmation)
# NTFY_CONTROL_TOPIC: Outstanding updates, remote action buttons, and command listener (restricted access)
NTFY_ALERTS_TOPIC="abcdef0123456789-yourgroup-alerts"
NTFY_REBOOT_TOPIC="abcdef0123456789-yourgroup-reboot"
NTFY_CONTROL_TOPIC="abcdef0123456789-yourgroup-control"

# Legacy Single-Topic Fallback (used only if 3-topic channels above are unset)
# NTFY_TOPIC:  use this in a channel per machine configuration

# NTFY_TOKEN: Per machine authentication token. If a machine is compromised, revoke the token in NTFY to lock it out of the pod.
NTFY_TOKEN="your-token-here"

# Healthchecks.io per maching Ping URL (Note: In Healthchecks.io dashboard, configure NTFY integration pointing to NTFY_ALERTS_TOPIC.
# each HC alert to NTFY share the same NYTFY access token)
HC_PING_URL="https://hc-ping.com/your-uuid-here"

# Optional: Dedicated NTFY command topic for remote action button triggers (defaults to NTFY_CONTROL_TOPIC)
# NTFY_CMD_TOPIC="abcdef0123456789-yourgroup-control"

# Required for access control: Restrict remote action triggers to a verified publisher username (NTFY JSON stream ACL)
NTFY_VALID_USER="your-ntfy-username"

# Optional: Shared cryptographic secret for HMAC-SHA256 signing of remote action buttons
# Generate with: openssl rand -hex 32
# FLEET_SECRET="your-32-byte-hex-secret-here"
# FLEET_SECRET_CREATED_DATE="1729350000"
# FLEET_SECRET_PREVIOUS=""

# Maintenance Constraints & Safety Locks
MAINTENANCE_WINDOW_START="02:00"
MAINTENANCE_WINDOW_END="05:00"
REBOOT_DELAY_MINUTES="5"
BLOCKED_PROCESSES=("apt" "apt-get" "dpkg" "unattended-upgrade" "dnf" "yum" "rpm" "check-updates" "backup_job" "db_migration" "rsync")
